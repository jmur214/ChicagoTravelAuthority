# Copy to client/.env.local if you need to override defaults.

# Where production builds send API requests. Leave empty when the API is served
# from the same origin as the web app.
# VITE_API_URL=https://api.your-site.example

# Dev only: where the Vite dev server proxies /api requests.
# VITE_DEV_API_PROXY=http://localhost:3000
