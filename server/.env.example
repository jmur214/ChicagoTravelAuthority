# Copy to server/.env and adjust. Only DATABASE_URL is required.

DATABASE_URL="postgresql://postgres@localhost:5432/chicago_planner?schema=public"
PORT=3000

# Comma-separated browser origins allowed to call the API. Leave unset in local dev
# (allows any origin). Set it in production. Native mobile apps are unaffected by CORS.
# CORS_ORIGINS="https://your-site.example,http://localhost:5173"

# Live CTA train positions (https://www.transitchicago.com/developers/traintrackerapply/).
# Without a key the API serves animated mock trains.
# CTA_TRAIN_API_KEY=
# CTA_POLL_INTERVAL_MS=20000

# Directory containing the unzipped CTA GTFS feed (routes.txt, trips.txt, shapes.txt).
# Defaults to <repo>/google_transit. Without it, train lines are not drawn.
# GTFS_DIR=

# Upload limit for KML/KMZ imports.
# MAX_UPLOAD_MB=10

# Only used by scripts/enrich_places_api.ts
# GOOGLE_PLACES_KEY=
